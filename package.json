{
  "name": "mugendojo-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@mugen/mobile",
    "dev:mobile:tunnel": "turbo run dev:tunnel --filter=@mugen/mobile",
    "dev:admin": "turbo run dev --filter=@mugen/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "npx --yes supabase@latest start",
    "db:stop": "npx --yes supabase@latest stop",
    "db:migrate": "npx --yes supabase@latest db push",
    "db:reset": "npx --yes supabase@latest db reset",
    "db:types": "npx --yes supabase@latest gen types typescript --local > packages/shared/src/database.generated.ts",
    "db:status": "npx --yes supabase@latest status",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/lightningcss/lightningcss.linux-x64-gnu.node',t='node_modules/lightningcss-linux-x64-gnu/lightningcss.linux-x64-gnu.node';if(!fs.existsSync(p)&&fs.existsSync(t))fs.symlinkSync(require('path').resolve(t),p);console.log('postinstall: lightningcss native binary linked')\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {}
}
