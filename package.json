{
  "name": "mugendojo-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@mugen/mobile",
    "dev:admin": "turbo run dev --filter=@mugen/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "npx --yes supabase@latest start",
    "db:stop": "npx --yes supabase@latest stop",
    "db:migrate": "npx --yes supabase@latest db push",
    "db:reset": "npx --yes supabase@latest db reset",
    "db:types": "npx --yes supabase@latest gen types typescript --local > packages/shared/src/types/database.types.ts",
    "db:status": "npx --yes supabase@latest status"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {}
}
